#!/usr/bin/ucode
'use strict';

import * as service from 'ecycloud.service';

import { mihomoBin, sessionLease, state } from 'ecycloud.common';

const session = ARGV[0] in [ 'kernel', 'cleanup', 'revert' ] ? true : sessionLease();
if (!session) {
	warn('账户正在切换，后台任务已拒绝\n');
	exit(1);
}

switch (ARGV[0]) {
case 'kernel':
	printf('%s\n', mihomoBin());
	exit(0);

case 'prepare':
	exit(service.prepare() ? 0 : state().retryable ? 2 : 1);

case 'retry':
	service.retryPrepare();
	exit(0);

case 'revert':
	exit(service.deactivate() ? 0 : 1);

case 'cleanup':
	exit(service.cleanup() ? 0 : 1);

case 'watchdog':
	service.watchdog();
	exit(0);

case 'refresh':
	service.refresh();
	exit(0);

case 'statistics':
	service.collectStatistics();
	exit(0);

case 'delay':
	service.runDelay();
	exit(0);

case 'speed':
	service.runSpeed();
	exit(0);

case 'rules':
	service.runRuleProviders();
	exit(0);

case 'close-via':
	service.runCloseVia(ARGV[1] ?? '');
	exit(0);

case 'icons':
	service.syncIcons();
	exit(0);

case 'update': {
	const res = service.update(ARGV[1] == 'force');

	if (!res.ok) {
		warn(`${res.error}\n`);
		exit(1);
	}

	printf('%s\n', res.changed ? (res.reloaded ? '配置已热载' : '配置已更新，等待内核启动') : '配置无变化');
	exit(0);
}

default:
	warn('usage: ecycloud-ctl kernel|prepare|retry|cleanup|revert|update [force]|watchdog|refresh|statistics|delay|speed|rules|close-via|icons\n');
	exit(1);
}
