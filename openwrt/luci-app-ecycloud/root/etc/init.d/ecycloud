#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

CTL=/usr/libexec/ecycloud-ctl

has_session() {
	[ -s /etc/ecycloud/credentials.json ] || return 1
	grep -qE '"token":[[:space:]]*"[^"]+"' /etc/ecycloud/credentials.json
}

boot() {
	local auto_connect enabled=0
	config_load ecycloud
	config_get_bool auto_connect config auto_connect 0
	if [ "$auto_connect" = 1 ] && has_session; then
		enabled=1
	fi
	uci -q set ecycloud.config.enabled="$enabled" || return 1
	uci -q commit ecycloud || return 1
	# 断电后 nftables.d 里的片段还在，策略路由和运行状态已丢：不先撤掉，待机内核一监听就吞掉 LAN 流量
	"$CTL" revert
	start
}

# 插件运行期自己改写并已即时生效的键不算：否则这些提交会在别的页面「保存并应用」时被 reload_config 当成改动，白白重启内核
config_fingerprint() {
	uci -q show ecycloud | grep -vE '^ecycloud\.config\.(enabled|route_mode|site_url|sub_url)=' | md5sum | cut -d' ' -f1
}

start_service() {
	local enabled run_dir

	mkdir -m 700 -p /var/run/ecycloud
	config_fingerprint > /var/run/ecycloud/config.md5
	config_load ecycloud
	config_get_bool enabled config enabled 0

	[ "$enabled" = 1 ] || has_session || return 0

	if "$CTL" prepare; then
		:
	else
		local status=$?
		[ "$status" = 2 ] && [ "$enabled" = 1 ] || return 1
		procd_open_instance retry
		procd_set_param command "$CTL" retry
		procd_set_param stderr 1
		procd_close_instance
		return 0
	fi
	run_dir="$("$CTL" rundir)" || return 1

	procd_open_instance core
	procd_set_param command "$("$CTL" kernel)" -d "$run_dir" -f "$run_dir/kernel.json"
	procd_set_param limits core="0 0" nofile="65535 65535"
	procd_set_param respawn 3600 5 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance watchdog
	procd_set_param command "$CTL" watchdog
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance refresh
	procd_set_param command "$CTL" refresh
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance statistics
	procd_set_param command "$CTL" statistics
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	"$CTL" cleanup
}

reload_service() {
	[ "$(config_fingerprint)" = "$(cat /var/run/ecycloud/config.md5 2>/dev/null)" ] && return 0
	restart
}

service_triggers() {
	procd_add_reload_trigger ecycloud
}
