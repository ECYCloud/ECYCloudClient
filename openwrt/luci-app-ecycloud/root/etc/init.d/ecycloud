#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

CTL=/usr/libexec/ecycloud-ctl

start_service() {
	local enabled run_dir

	config_load ecycloud
	config_get_bool enabled config enabled 0
	config_get run_dir config run_dir /etc/ecycloud/run

	[ "$enabled" = 1 ] || return 0

	mkdir -p "$run_dir"
	"$CTL" prepare || return 1

	procd_open_instance core
	procd_set_param command "$("$CTL" kernel)" -d "$run_dir" -f "$run_dir/config.json"
	procd_set_param limits core="0 0" nofile="65535 65535"
	procd_set_param respawn 3600 5 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance watchdog
	procd_set_param command "$CTL" watchdog
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	"$CTL" cleanup
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger ecycloud
}
