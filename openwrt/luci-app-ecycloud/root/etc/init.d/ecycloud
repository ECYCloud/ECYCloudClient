#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

CTL=/usr/libexec/ecycloud-ctl

has_session() {
	[ -s /etc/ecycloud/credentials.json ] || return 1
	grep -qE '"token":[[:space:]]*"[^"]+"' /etc/ecycloud/credentials.json
}

boot() {
	local auto_connect enabled=0
	config_load ecycloud
	config_get_bool auto_connect config auto_connect 0
	if [ "$auto_connect" = 1 ] && has_session; then
		enabled=1
	fi
	uci -q set ecycloud.config.enabled="$enabled" || return 1
	uci -q commit ecycloud || return 1
	start
}

start_service() {
	local enabled run_dir=/etc/ecycloud/run
	[ ! -e /var/run/ecycloud/session-changing ] || return 1

	config_load ecycloud
	config_get_bool enabled config enabled 0

	[ "$enabled" = 1 ] || has_session || return 0

	if "$CTL" prepare; then
		:
	else
		local status=$?
		[ "$status" = 2 ] && [ "$enabled" = 1 ] || return 1
		procd_open_instance retry
		procd_set_param command "$CTL" retry
		procd_set_param stderr 1
		procd_close_instance
		return 0
	fi
	[ ! -e /var/run/ecycloud/session-changing ] || return 1

	procd_open_instance core
	procd_set_param command "$("$CTL" kernel)" -d "$run_dir" -f "$run_dir/config.json"
	procd_set_param limits core="0 0" nofile="65535 65535"
	procd_set_param respawn 3600 5 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance watchdog
	procd_set_param command "$CTL" watchdog
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance refresh
	procd_set_param command "$CTL" refresh
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance statistics
	procd_set_param command "$CTL" statistics
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	"$CTL" cleanup
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger ecycloud
}
