config ecycloud 'config'
	option enabled '0'
	option mode 'tproxy'
	option route_mode 'rule'
	option log_level 'warning'
	option tproxy_port '7894'
	option mixed_port '7890'
	option dns_port '7853'
	option allow_lan '1'
	option ipv6 '1'
	option dns_hijack '1'
	option router_proxy '0'
	option tun_device 'ECYCloud'
	option tun_stack 'mixed'
	option run_dir '/etc/ecycloud/run'
	option geox_base 'https://rules.ecydy.com/Clash'
	option refresh_interval '5'
	list lan_interface 'lan'
